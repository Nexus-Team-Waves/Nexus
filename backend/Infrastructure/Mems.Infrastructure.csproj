<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\Mems.Application.csproj" />
    <ProjectReference Include="..\Domain\Mems.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DEMO persistence. EF Core InMemory keeps the whole approval workflow live for a running
         demo with no external SQL Server. Production swaps this for Microsoft.EntityFrameworkCore.SqlServer
         (SQL Server 2019, CLAUDE.md §3) — the DbContext and repositories are provider-agnostic. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
