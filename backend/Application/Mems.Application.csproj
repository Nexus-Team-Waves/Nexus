<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Domain\Mems.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FluentValidation is explicitly sanctioned for input validation in CLAUDE.md §6.
         It is a light, mainstream library — not a "heavyweight dependency" under §13. -->
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <!-- ILogger abstractions only (no provider) so Application services can log per CLAUDE.md §6. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
